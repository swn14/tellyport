{
  "unstable": ["kv"],
  "deploy": {
    "install": "npm ci --prefix client",
    "build": "deno task build",
    "runtime": {
      "type": "dynamic",
      "entrypoint": "app.ts"
    }
  },
  "tasks": {
    "build": "deno run -A build.ts",
    "serve": "deno run -A app.ts",
    "start": "deno task build && deno task serve"
  }
}
